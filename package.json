{
  "name": "simplecatch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "cd apps/api-py && uv run python scripts/prepare_db.py",
    "e2e": "playwright test",
    "dev:api": "cd apps/api-py && RUN_BACKGROUND_JOBS=false uv run watchfiles \"python -m app.dev_server\" app",
    "dev:worker": "cd apps/api-py && uv run watchfiles \"python -m app.workers.messaging\" app",
    "dev:web": "pnpm --filter @simplecatch/web dev",
    "test:api": "cd apps/api-py && uv run pytest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
