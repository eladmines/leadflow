# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow
# Used by automated tests only.
TEST_DATABASE_URL=postgresql://leadflow:leadflow@localhost:5432/leadflow_test
# Comma-separated origins allowed to call the API with cookies.
WEB_ORIGINS=http://localhost:5173

# --- F01: Authentication & sessions ---
# Base URL of the web app, used in email links (no trailing slash). Required in production.
APP_URL=http://localhost:5173
# 'true' or 'false' only. Defaults to true in production (where it must be true), else false.
COOKIE_SECURE=false
# smtp | memory (tests use memory).
EMAIL_TRANSPORT=smtp
# on | off. Off (default): nobody is asked to verify their email and no verify email is sent (D-133).
EMAIL_VERIFICATION=off
# Mailpit locally (UI at http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM="LeadFlow <no-reply@leadflow.local>"
# A real mail server with a login (D-119), e.g. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_SECURE=true, SMTP_USER=<gmail address>, SMTP_PASS=<app password>. Empty for Mailpit.
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Auth rate limit: requests per client IP per route, per window (milliseconds).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=900000

# F06 — published customer sites. Local: http://<subdomain>.lvh.me:4100 (lvh.me resolves to 127.0.0.1).
PUBLIC_PORT=4100
PUBLIC_SITE_HOST=lvh.me:4100
# host = each site on its own subdomain; path = sites at APP_URL/s/<name> on PORT (no domain, D-119).
PUBLIC_SITE_MODE=host
# Serve the built web app (apps/web/dist) from the API's port. Empty locally (Vite serves it).
WEB_DIST_DIR=
# disk = MEDIA_DIR; database = images in Postgres (hosts whose disk is wiped on restart).
STORAGE_DRIVER=disk

# F12 POC — WhatsApp (D-091). Leave WHATSAPP_BUSINESS_ID empty to keep WhatsApp off.
# local = messages you send are recorded, not delivered; cloud = Meta's Graph API.
WHATSAPP_PROVIDER=local
# LeadFlow business id the number belongs to (from the app URL /b/<id>/...).
WHATSAPP_BUSINESS_ID=
# Any random string locally; in Meta: App settings → Basic → App secret.
WHATSAPP_APP_SECRET=local-dev-app-secret-change-me
# Any word; type the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=local-dev-verify-token
# cloud only (Meta → WhatsApp → API setup): "Phone number ID" and an access token.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
