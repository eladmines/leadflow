// LeadFlow data model. Every tenant-owned table MUST carry business_id
// (see docs/ARCHITECTURE.md#tenant-isolation). Models are added per feature.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// F01 — Authentication & sessions. Users, sessions and auth tokens are global
// (not tenant-owned). audit_logs carries a nullable business_id: auth events
// have none; tenant events (F02+) always set it.
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  /// Always stored trimmed + lowercased (shared emailSchema), so plain equality is case-insensitive.
  email           String     @unique @db.VarChar(254)
  /// argon2id PHC string. Never selected into API responses or logs.
  passwordHash    String     @map("password_hash")
  fullName        String     @map("full_name") @db.VarChar(100)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  status          UserStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions           Session[]
  authTokens         AuthToken[]
  auditLogs          AuditLog[]
  memberships        Membership[]
  siteVersions       SiteVersion[]
  ownedLeads         Lead[]
  sentInvites        Invitation[]      @relation("InvitedBy")
  tasks              Task[]            @relation("TaskAssignee")
  appointments       Appointment[]     @relation("AppointmentStaff")
  whatsappSent       WhatsAppMessage[]
  whatsappClassified WhatsAppNumber[]  @relation("WhatsAppClassifiedBy")
  notifications      Notification[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  /// SHA-256 (hex) of the cookie token. The raw token is never stored.
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  /// Sliding idle expiry: min(last_seen_at + 30d, absolute_expires_at).
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  /// created_at + 90d; never extended.
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ip                String?   @db.VarChar(45)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  /// SHA-256 (hex) of the emailed token. The raw token is never stored.
  tokenHash String        @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime      @map("expires_at") @db.Timestamptz(3)
  /// Set when consumed or superseded; a token with used_at is invalid.
  usedAt    DateTime?     @map("used_at") @db.Timestamptz(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  /// Null for platform-level events (auth). Always set for tenant events.
  businessId  String?  @map("business_id") @db.Uuid
  /// Null when there is no authenticated actor (e.g. failed login for an unknown email).
  actorUserId String?  @map("actor_user_id") @db.Uuid
  /// Dotted action name, e.g. "auth.login.succeeded" (see shared authAuditActions).
  action      String   @db.VarChar(100)
  entityType  String?  @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  /// Never contains passwords, tokens, hashes or cookies.
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor    User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// F02 — Businesses (tenants) and memberships
// ---------------------------------------------------------------------------

enum BusinessStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

enum MembershipRole {
  OWNER
  MANAGER
  EMPLOYEE
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

/// The tenant. Every tenant-owned table references it through business_id.
model Business {
  id                     String         @id @default(uuid()) @db.Uuid
  name                   String         @db.VarChar(80)
  /// Code from the shared INDUSTRIES list (validated in the app, not a DB enum).
  industry               String         @db.VarChar(40)
  /// E.164, e.g. +972501234567.
  phone                  String?        @db.VarChar(20)
  address                String?        @db.VarChar(200)
  serviceAreas           String[]       @default([]) @map("service_areas")
  /// Shape: shared openingHoursSchema (sun..sat → { open, from, to }).
  openingHours           Json?          @map("opening_hours")
  /// Existing website outside LeadFlow (D-094); shown in "האתר שלי", never managed by LeadFlow.
  websiteUrl             String?        @map("website_url") @db.VarChar(300)
  timezone               String         @default("Asia/Jerusalem") @db.VarChar(64)
  /// 'he' | 'en' (D-143): what its customers get (website, WhatsApp, emails).
  language               String         @default("he") @db.VarChar(2)
  /// WhatsApp booking bot (D-102): off by default; confirmed bookings unless autoConfirm is off.
  whatsappBotEnabled     Boolean        @default(false) @map("whatsapp_bot_enabled")
  whatsappBotAutoConfirm Boolean        @default(true) @map("whatsapp_bot_auto_confirm")
  /// The business's own bot messages (shared botTextsSchema); missing keys use the defaults.
  whatsappBotTexts       Json?          @map("whatsapp_bot_texts")
  /// "In the meantime" showcase (D-106; shared botShowcaseSchema).
  whatsappBotShowcase    Json?          @map("whatsapp_bot_showcase")
  /// 'appointment' | 'event' (D-107); null = the industry's flow.
  whatsappBotFlow        String?        @map("whatsapp_bot_flow") @db.VarChar(20)
  /// Event requests hold their date (D-108); off = only confirmed events block a date.
  whatsappBotHoldDate    Boolean        @default(false) @map("whatsapp_bot_hold_date")
  /// D-123: off | auto_reply | booking (booking also keeps whatsappBotEnabled on).
  whatsappReplyMode      String         @default("auto_reply") @map("whatsapp_reply_mode") @db.VarChar(20)
  /// The general automatic reply; null = the default text.
  whatsappAutoReplyText  String?        @map("whatsapp_auto_reply_text") @db.VarChar(1000)
  /// [{ id, label, text, videoKey?, videoBytes? }]; null = the ready-made statuses.
  whatsappStatuses       Json?          @map("whatsapp_statuses")
  /// { id, until } — the status on now.
  whatsappActiveStatus   Json?          @map("whatsapp_active_status")
  status                 BusinessStatus @default(ONBOARDING)
  /// Last saved wizard step (1..4); meaningful only while status = ONBOARDING.
  onboardingStep         Int            @default(1) @map("onboarding_step")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  memberships         Membership[]
  auditLogs           AuditLog[]
  site                Site?
  contacts            Contact[]
  leads               Lead[]
  stages              PipelineStage[]
  invitations         Invitation[]
  assets              Asset[]
  tasks               Task[]
  services            Service[]
  quotes              Quote[]
  appointments        Appointment[]
  whatsapp            WhatsAppMessage[]
  whatsappNumbers     WhatsAppNumber[]
  whatsappBotSessions WhatsAppBotSession[]
  notifications       Notification[]

  @@map("businesses")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  businessId     String           @map("business_id") @db.Uuid
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  invitedAt      DateTime?        @map("invited_at") @db.Timestamptz(3)
  /// Email on new website leads (owners/managers receive them; each can opt out).
  notifyNewLeads Boolean          @default(true) @map("notify_new_leads")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("memberships")
}

// ---------------------------------------------------------------------------
// F04 — Site builder (single-page site per business in the MVP, D-030)
// ---------------------------------------------------------------------------

enum SiteStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

model Site {
  id                 String     @id @default(uuid()) @db.Uuid
  /// One site per business in the MVP (Basic plan); becomes non-unique if plans allow more.
  businessId         String     @unique @map("business_id") @db.Uuid
  templateKey        String     @map("template_key") @db.VarChar(30)
  /// Shapes: shared themeSchema / seoSchema / sectionSchema[] (validated on every write).
  theme              Json
  seo                Json
  sections           Json
  /// Extra pages (D-081): [{ id, slug, title, inMenu, seo, sections }].
  pages              Json       @default("[]")
  /// Optimistic-locking counter for the draft; incremented on every successful save.
  revision           Int        @default(0)
  status             SiteStatus @default(DRAFT)
  /// Globally unique public name (shared subdomainSchema). Null until chosen.
  subdomain          String?    @unique @db.VarChar(40)
  /// The live version; null = not published. Switched atomically on publish/rollback/unpublish.
  publishedVersionId String?    @unique @map("published_version_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  versions         SiteVersion[]    @relation("SiteVersions")
  submissions      FormSubmission[]
  publishedVersion SiteVersion?     @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)

  @@map("sites")
}

/// Immutable published snapshot (D-036: stored in Postgres in the MVP, moves to R2 with the Worker).
model SiteVersion {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  siteId        String   @map("site_id") @db.Uuid
  /// 1, 2, 3… per site.
  number        Int
  /// The draft revision this version was rendered from.
  draftRevision Int      @map("draft_revision")
  /// Rendered page (renderSitePage) — served as-is by the public site server.
  html          String
  /// Extra pages' HTML by address (D-081).
  pageHtml      Json     @default("{}") @map("page_html")
  /// The draft (theme, seo, sections) and business info used, for audit and future re-rendering.
  content       Json
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  site      Site  @relation("SiteVersions", fields: [siteId], references: [id], onDelete: Cascade)
  liveOn    Site? @relation("PublishedVersion")
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([siteId, number])
  @@index([businessId])
  @@map("site_versions")
}

// ---------------------------------------------------------------------------
// F07 — Lead capture (F08 builds the CRM on these tables)
// ---------------------------------------------------------------------------

enum StageKind {
  OPEN
  WON
  LOST
}

enum LeadSource {
  website_form
  manual
  whatsapp
  /// F23: a message to the business's Facebook Page (D-157).
  facebook
}

/// A person who contacted the business. Matched by phone within the business.
model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  name       String   @db.VarChar(80)
  /// E.164.
  phone      String?  @db.VarChar(20)
  email      String?  @db.VarChar(254)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads            Lead[]
  appointments     Appointment[]
  whatsapp         WhatsAppMessage[]
  messengerSenders WhatsAppNumber[]  @relation("MessengerContact")

  @@index([businessId, phone])
  @@index([businessId, email])
  @@map("contacts")
}

/// Ordered pipeline stages per business; seeded with the PRD defaults on first use.
model PipelineStage {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  name       String    @db.VarChar(40)
  position   Int
  kind       StageKind @default(OPEN)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([businessId, position])
  @@map("pipeline_stages")
}

model Lead {
  id            String     @id @default(uuid()) @db.Uuid
  businessId    String     @map("business_id") @db.Uuid
  contactId     String     @map("contact_id") @db.Uuid
  stageId       String     @map("stage_id") @db.Uuid
  /// Assigned team member (F08). Employees only see leads assigned to them.
  ownerId       String?    @map("owner_id") @db.Uuid
  source        LeadSource
  sourceUrl     String?    @map("source_url") @db.VarChar(300)
  message       String?    @db.VarChar(1000)
  /// Expected deal value in whole shekels (F08).
  expectedValue Int?       @map("expected_value")
  nextActionAt  DateTime?  @map("next_action_at") @db.Timestamptz(3)
  /// Free labels (max 10 × 30 chars, validated in shared).
  tags          String[]   @default([])
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact      Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage        PipelineStage     @relation(fields: [stageId], references: [id])
  owner        User?             @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  activities   Activity[]
  submission   FormSubmission?
  tasks        Task[]
  appointments Appointment[]
  quotes       Quote[]
  whatsapp     WhatsAppMessage[]

  @@index([businessId, createdAt])
  @@index([businessId, stageId])
  @@index([businessId, ownerId])
  @@index([businessId, nextActionAt])
  @@map("leads")
}

/// Raw accepted website-form submission; the idempotency key stops double-submits creating two leads.
model FormSubmission {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  /// Null once the site is deleted (D-095): the submission stays as the lead's consent record.
  siteId         String?  @map("site_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key") @db.VarChar(64)
  /// The validated fields (name, phone, email, message) — personal data; never logged.
  payload        Json
  consentAt      DateTime @map("consent_at") @db.Timestamptz(3)
  /// Salted hash of the visitor IP (abuse analysis without storing the IP).
  ipHash         String   @map("ip_hash") @db.VarChar(64)
  leadId         String   @unique @map("lead_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)
  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([siteId, idempotencyKey])
  @@index([businessId, createdAt])
  @@map("form_submissions")
}

/// History of a lead (created, stage changed, note…). F08 adds more types.
model Activity {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  leadId     String   @map("lead_id") @db.Uuid
  type       String   @db.VarChar(50)
  data       Json     @default("{}")
  actorId    String?  @map("actor_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([businessId, leadId, createdAt])
  @@map("activities")
}

// ---------------------------------------------------------------------------
// F09 — Team invitations
// ---------------------------------------------------------------------------

/// Pending/used invitation to join a business. Only the token hash is stored.
model Invitation {
  id          String         @id @default(uuid()) @db.Uuid
  businessId  String         @map("business_id") @db.Uuid
  /// Trimmed + lowercased; the invitee must sign in with exactly this address to accept.
  email       String         @db.VarChar(254)
  role        MembershipRole
  tokenHash   String         @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)
  invitedById String?        @map("invited_by_id") @db.Uuid
  acceptedAt  DateTime?      @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User?    @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([businessId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// F05 — Media
// ---------------------------------------------------------------------------

/// An uploaded image, re-encoded to WebP. The file lives in object storage under `key`.
model Asset {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  /// `<businessId>/<uuid>.webp` — unguessable, immutable (new upload = new key).
  key          String   @unique @db.VarChar(120)
  mime         String   @db.VarChar(40)
  sizeBytes    Int      @map("size_bytes")
  width        Int
  height       Int
  originalName String?  @map("original_name") @db.VarChar(200)
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@map("assets")
}

/// Image bytes for STORAGE_DRIVER=database (D-119): hosts whose disk is wiped on restart. Not a
/// tenant table of its own — the `assets` row owns it by `key` (`<businessId>/<uuid>.webp`),
/// and only the storage provider reads it.
model StoredObject {
  key         String   @id @db.VarChar(120)
  contentType String   @map("content_type") @db.VarChar(60)
  body        Bytes
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("stored_objects")
}

// ---------------------------------------------------------------------------
// F10 — Follow-up tasks
// ---------------------------------------------------------------------------

enum TaskStatus {
  OPEN
  DONE
}

model Task {
  id             String     @id @default(uuid()) @db.Uuid
  businessId     String     @map("business_id") @db.Uuid
  title          String     @db.VarChar(200)
  notes          String?    @db.VarChar(1000)
  dueAt          DateTime   @map("due_at") @db.Timestamptz(3)
  status         TaskStatus @default(OPEN)
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(3)
  assigneeId     String     @map("assignee_id") @db.Uuid
  leadId         String?    @map("lead_id") @db.Uuid
  /// Email the assignee when due; `reminderSentAt` makes it once-only (claimed atomically).
  remind         Boolean    @default(true)
  reminderSentAt DateTime?  @map("reminder_sent_at") @db.Timestamptz(3)
  createdById    String?    @map("created_by_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignee User     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([businessId, status, dueAt])
  @@index([businessId, assigneeId, status])
  @@index([businessId, leadId])
  @@index([status, remind, reminderSentAt, dueAt])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// F17 — Appointments
// ---------------------------------------------------------------------------

model Service {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  name        String   @db.VarChar(80)
  durationMin Int      @map("duration_min")
  /// Whole shekels; null = no price shown.
  price       Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([businessId, active])
  @@map("services")
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  businessId  String            @map("business_id") @db.Uuid
  contactId   String            @map("contact_id") @db.Uuid
  leadId      String?           @map("lead_id") @db.Uuid
  serviceId   String?           @map("service_id") @db.Uuid
  /// Staff member; null only for website requests not yet assigned.
  staffId     String?           @map("staff_id") @db.Uuid
  startsAt    DateTime          @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime          @map("ends_at") @db.Timestamptz(3)
  status      AppointmentStatus @default(CONFIRMED)
  notes       String?           @db.VarChar(1000)
  /// 'manual' | 'website'
  source      String            @default("manual") @db.VarChar(20)
  createdById String?           @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  service  Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  staff    User?    @relation("AppointmentStaff", fields: [staffId], references: [id], onDelete: SetNull)

  @@index([businessId, startsAt])
  @@index([businessId, staffId, startsAt])
  @@index([businessId, status])
  @@index([businessId, leadId])
  @@map("appointments")
}

// ---------------------------------------------------------------------------
// F18 — Quotes
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Quote {
  id          String      @id @default(uuid()) @db.Uuid
  businessId  String      @map("business_id") @db.Uuid
  leadId      String      @map("lead_id") @db.Uuid
  /// Sequential per business (1001, 1002, …).
  number      Int
  title       String      @default("") @db.VarChar(120)
  /// [{ description, quantity, unitPrice (agorot) }], validated in shared.
  items       Json
  /// Agorot.
  discount    Int         @default(0)
  vatRate     Decimal     @default(18) @map("vat_rate") @db.Decimal(4, 2)
  notes       String      @default("") @db.VarChar(2000)
  validUntil  DateTime?   @map("valid_until") @db.Date
  status      QuoteStatus @default(DRAFT)
  /// Unguessable customer-page token (a capability link, like media keys); set when first sent.
  publicToken String?     @unique @map("public_token") @db.VarChar(64)
  sentAt      DateTime?   @map("sent_at") @db.Timestamptz(3)
  decidedAt   DateTime?   @map("decided_at") @db.Timestamptz(3)
  createdById String?     @map("created_by_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([businessId, number])
  @@index([businessId, status])
  @@index([businessId, leadId])
  @@map("quotes")
}

// ---------------------------------------------------------------------------
// F12 POC — WhatsApp (Meta Cloud API, D-091)
// ---------------------------------------------------------------------------

enum WhatsAppDirection {
  IN
  OUT
}

enum WhatsAppNumberStatus {
  /// New number: its messages wait in the inbox until the owner classifies it.
  UNCLASSIFIED
  /// Customer: messages go to the CRM (contact + lead).
  BUSINESS
  /// Private contact: messages are not stored; only the number is kept so it stays ignored.
  PERSONAL
}

/// What a business decided about a WhatsApp number (D-092). Remembered for future conversations.
model WhatsAppNumber {
  id             String               @id @default(uuid()) @db.Uuid
  businessId     String               @map("business_id") @db.Uuid
  /// `whatsapp` (default) or `messenger` (F23, D-157).
  channel        String               @default("whatsapp") @db.VarChar(20)
  /// WhatsApp: E.164. Messenger: `fb:` + the sender's page-scoped id (PSID).
  phone          String               @db.VarChar(64)
  /// Messenger only: the contact this sender became (WhatsApp matches contacts by phone).
  contactId      String?              @map("contact_id") @db.Uuid
  status         WhatsAppNumberStatus
  /// WhatsApp profile name while unclassified (cleared when marked personal).
  profileName    String?              @map("profile_name") @db.VarChar(80)
  /// Null when classified automatically (an existing contact).
  classifiedById String?              @map("classified_by_id") @db.Uuid
  classifiedAt   DateTime?            @map("classified_at") @db.Timestamptz(3)
  /// Last time the booking bot sent this number the showcase (at most once a day, D-106).
  botShowcaseAt  DateTime?            @map("bot_showcase_at") @db.Timestamptz(3)
  /// The owner paused the booking bot for this customer (D-108).
  botPaused      Boolean              @default(false) @map("bot_paused")
  /// Last automatic reply to this number (D-123): at most one per 12 hours.
  autoReplyAt    DateTime?            @map("auto_reply_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact      Contact?            @relation("MessengerContact", fields: [contactId], references: [id], onDelete: SetNull)
  classifiedBy User?               @relation("WhatsAppClassifiedBy", fields: [classifiedById], references: [id], onDelete: SetNull)
  messages     WhatsAppMessage[]
  botSession   WhatsAppBotSession?

  @@unique([businessId, phone])
  @@index([businessId, status])
  @@map("whatsapp_numbers")
}

/// Where one WhatsApp chat is in the booking bot (D-102). One per number; expires when idle.
model WhatsAppBotSession {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  numberId   String   @unique @map("number_id") @db.Uuid
  /// service | day | time | confirm | handoff
  step       String   @db.VarChar(20)
  serviceId  String?  @map("service_id") @db.Uuid
  /// YYYY-MM-DD in the business's time zone.
  date       String?  @db.VarChar(10)
  /// HH:MM.
  time       String?  @db.VarChar(5)
  /// Event requests (D-107): type, part of day, guests, area as they are answered.
  data       Json?
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number   WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("whatsapp_bot_sessions")
}

/// One WhatsApp message. Meta's message id makes webhook retries idempotent.
model WhatsAppMessage {
  id          String            @id @default(uuid()) @db.Uuid
  businessId  String            @map("business_id") @db.Uuid
  numberId    String            @map("number_id") @db.Uuid
  /// Set once the number is a customer; null while it waits in the inbox.
  contactId   String?           @map("contact_id") @db.Uuid
  /// Lead the message arrived on (or was sent from); kept null if that lead is deleted.
  leadId      String?           @map("lead_id") @db.Uuid
  direction   WhatsAppDirection
  /// Meta's message id (wamid.*).
  waMessageId String            @unique @map("wa_message_id") @db.VarChar(128)
  body        String            @db.VarChar(4096)
  /// received | sent | delivered | read | failed (shared WHATSAPP_STATUSES).
  status      String            @db.VarChar(20)
  senderId    String?           @map("sender_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  number   WhatsAppNumber @relation(fields: [numberId], references: [id], onDelete: Cascade)
  contact  Contact?       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  lead     Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  sender   User?          @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([businessId, contactId, createdAt])
  @@index([numberId, createdAt])
  @@map("whatsapp_messages")
}

// ---------------------------------------------------------------------------
// In-app notifications (D-097)
// ---------------------------------------------------------------------------

/// One notification for one user in one business (bell + pop-ups).
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// shared NOTIFICATION_TYPES, e.g. lead.new.
  type       String    @db.VarChar(40)
  /// Type-specific details (ids for the link, a name, a short preview).
  data       Json      @default("{}")
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, businessId, createdAt])
  @@map("notifications")
}
